<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/patching_apk"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/file_not_selected"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInspectorApk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:text="@string/inspector_title"
            android:textSize="16sp"
            app:icon="@android:drawable/ic_menu_search"
            app:iconGravity="textStart"
            app:iconPadding="12dp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxGooglePlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_google_play_redirect"
            android:textSize="16sp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxRemoveAds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_ads_calls"
            android:textSize="16sp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxRemoveAnalytics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_analytics"
            android:textSize="16sp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxRemoveUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_update_check"
            android:textSize="16sp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxRemoveGPServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_gp_services"
            android:textSize="16sp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxRemoveVpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_vpn_detection"
            android:textSize="16sp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxRemoveInstallerCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_installer_check"
            android:textSize="16sp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxRemoveLocales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_locale_packages"
            android:textSize="16sp"/>

                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxRemoveDpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_dpi_duplicates"
            android:textSize="16sp"/>

        <!-- ✅ НОВЫЙ ЧЕКБОКС: Удаление библиотек (архитектур) -->
                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxRemoveLibs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/remove_libs_archs"
            android:textSize="16sp"/>

        <!-- ✅ НОВЫЙ ЧЕКБОКС: Оптимизация -->
                <com.google.android.material.button.MaterialButton
            android:id="@+id/checkBoxOptimize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:checkable="true"
            android:padding="16dp"
            android:text="@string/optimize"
            android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_patching"
            android:textSize="16sp"
            android:padding="16dp"
            app:icon="@android:drawable/ic_menu_manage"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            android:enabled="false"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>